GOOGLE_EVENT_STORE_BUCKET: "your-project-id-amilia-calendar-event-mappings"
GCP_PROJECT_ID: "your-project-id"
RECONCILE_QUEUE_ID: "amilia-activity-reconciliation"
RECONCILE_WORKER_URL: "https://your-region-your-project-id.cloudfunctions.net/amilia-activity-reconciler"
RECONCILE_QUEUE_LOCATION: "your-region"
RECONCILE_INVOKER_SERVICE_ACCOUNT: "amilia-calendar-updater@your-project-id.iam.gserviceaccount.com"

# Background webhook processing (see README "Background webhook processing").
# The queue shares RECONCILE_QUEUE_LOCATION and RECONCILE_INVOKER_SERVICE_ACCOUNT.
WEBHOOK_QUEUE_ID: "amilia-webhook-processing"
WEBHOOK_WORKER_URL: "https://your-region-your-project-id.cloudfunctions.net/amilia-webhook-worker"
# Give up (log the full webhook as status=discarded) after this long. Must stay
# below the queue's max_retry_duration (Terraform webhook_task_max_retry_duration, 25h).
WEBHOOK_TASK_GIVE_UP_AFTER_SECONDS: "86400"

# FacilityBooking sync is off unless this is "true" — see src/shared/feature_flags.py.
FACILITY_BOOKING_SYNC_ENABLED: "false"

# GOOGLE_CALENDAR_ID, AMILIA_WEBHOOK_TOKEN, AMILIA_API_USERNAME, and
# AMILIA_API_PASSWORD are NOT set
# here — they're secrets, mounted at deploy time via --set-secrets from
# Secret Manager instead. See main.py's deploy docstring.
# Don't add GOOGLE_CALENDAR_ID back here. It should be defined once, as a
# secret; Cloud Run (which runs gen2 functions) refuses to change a variable
# between a literal and a secret reference.
