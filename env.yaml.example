GOOGLE_EVENT_STORE_BUCKET: "your-project-id-amilia-calendar-event-mappings"
GCP_PROJECT_ID: "your-project-id"
RECONCILE_QUEUE_ID: "amilia-activity-reconciliation"
RECONCILE_WORKER_URL: "https://us-west1-your-project-id.cloudfunctions.net/amilia-activity-reconciler"

# GOOGLE_CALENDAR_ID, AMILIA_WEBHOOK_TOKEN, AMILIA_API_USERNAME, and
# AMILIA_API_PASSWORD are NOT set
# here — they're secrets, mounted at deploy time via --set-secrets from
# Secret Manager instead. See main.py's deploy docstring.
# Don't add GOOGLE_CALENDAR_ID back here. It should be defined once, as a
# secret; Cloud Run (which runs gen2 functions) refuses to change a variable
# between a literal and a secret reference.
